{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc 'python3 \"$HOME/.codex/hooks/pre_tool_policy.py\"'",
            "timeout": 5,
            "statusMessage": "Checking secret-protection policy"
          }
        ]
      }
    ]
  }
}
